    <string name="pref_show_handle">显示小白条</string>
    <string name="pref_show_handle_summary">在锁屏底部显示系统风格指示条</string>
    <string name="pref_parallax">上滑联动</string>
    <string name="pref_parallax_summary">上滑时壁纸、时间、快捷方式一起上移</string>
    <string name="pref_intercept_swipe">拦截系统上滑解锁</string>
    <string name="pref_intercept_swipe_summary">关掉系统自己的上滑解锁，改成只有时间跟着手指上移，到时间一半就停住，松手弹性归位；通知列表还能划，左右下角快捷方式不受影响</string>
    <string name="pref_handle_wide">扩大触控范围</string>
    <string name="pref_handle_wide_summary">触控区向左右扩展到屏幕两边（底部 36dp 整条都能按到），条本体外观不变</string>
    <string name="pref_hint_page">小横条上方文字</string>
    <string name="pref_hint_page_summary">文字内容、位置、大小、粗细、字体、颜色</string>

    <!-- 手感 -->
    <string name="group_feel">手感</string>
    <string name="pref_drag_ratio">跟手程度</string>
    <string name="pref_drag_ratio_summary">数值越大越贴手：100% 时内容与手指完全同步（1:1），需要滑满整屏才拉满；数值越小行程越短、轻轻一滑就到底，但内容会跑在手指前面。拖满行程后不管数值多少都会完全滑出屏幕，不会卡在半屏</string>
    <string name="pref_release_return">松手回弹</string>
    <string name="pref_release_return_summary">拉到一半以下松手会弹回原位；关闭则停在原地。拉到一半以上松手直接进解锁</string>
    <string name="pref_haptic">触感反馈</string>
    <string name="pref_haptic_summary">越过阈值与回弹时轻微震动</string>
    <string name="pref_handle_alpha">小白条不透明度</string>
    <string name="pref_handle_alpha_summary">拖动调节指示条的可见程度</string>

